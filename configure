#!/bin/sh
#
# configure - probe build-time dependencies and write config.make.
#
# This is a hand-rolled probe rather than autoconf because the
# checks are simple and we want zero external generator tools.
# Run before `make`; the generated config.make is included by
# Source/GNUmakefile.

set -eu

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PREFIX="/usr/GNUstep"
ENABLE_DEBUG=0
EXTRA_OBJCFLAGS=""

usage() {
  cat <<EOF
Usage: ./configure [options]

  --prefix=DIR        Install prefix (default: /usr/GNUstep)
  --enable-debug      Build with -g -O0 -DGS_WEBKIT_DEBUG=1
  --help              This message

The script probes pkg-config for required and optional dependencies
and writes config.make.  Run \`make\` afterwards.
EOF
}

for arg in "$@"; do
  case "$arg" in
    --prefix=*)         PREFIX="${arg#*=}";;
    --enable-debug)     ENABLE_DEBUG=1;;
    --help|-h)          usage; exit 0;;
    *) echo "Unknown option: $arg" >&2; usage; exit 1;;
  esac
done

say() { echo "  $*"; }

check_pkg() {
  # check_pkg LABEL VARPREFIX  pkg1 [pkg2 ...]
  local label="$1" varprefix="$2"
  shift 2
  if pkg-config --exists "$@" 2>/dev/null; then
    eval "${varprefix}_CFLAGS=\"\$(pkg-config --cflags $*)\""
    eval "${varprefix}_LIBS=\"\$(pkg-config --libs $*)\""
    say "$label: YES ($*)"
    return 0
  fi
  say "$label: NO"
  return 1
}

probe_optional() {
  local label="$1" varprefix="$2" sentinel="$3"
  shift 3
  if pkg-config --exists "$@" 2>/dev/null; then
    eval "${varprefix}_CFLAGS=\"\$(pkg-config --cflags $*) -D$sentinel=1\""
    eval "${varprefix}_LIBS=\"\$(pkg-config --libs $*)\""
    say "$label: YES (defines $sentinel)"
    return 0
  fi
  eval "${varprefix}_CFLAGS=\"\""
  eval "${varprefix}_LIBS=\"\""
  say "$label: NO"
  return 1
}

echo "=== Probing required dependencies ==="

if ! gnustep-config --variable=GNUSTEP_MAKEFILES >/dev/null 2>&1; then
  echo "gnustep-make is required.  Install gnustep-make and rerun." >&2
  exit 1
fi
GNUSTEP_MAKEFILES="$(gnustep-config --variable=GNUSTEP_MAKEFILES)"
say "gnustep-make: $GNUSTEP_MAKEFILES"

# WPE 2.0 (Debian 13 / current) preferred, fall back to 1.1.
if check_pkg "WPE WebKit 2.0" WPE2 wpe-webkit-2.0 wpe-1.0 wpebackend-fdo-1.0; then
  WPE_CFLAGS="$WPE2_CFLAGS -DGS_WEBKIT_WPE_API_2=1"
  WPE_LIBS="$WPE2_LIBS"
elif check_pkg "WPE WebKit 1.1" WPE1 wpe-webkit-1.1 libwpe-1.0 wpebackend-fdo-1.0; then
  WPE_CFLAGS="$WPE1_CFLAGS -DGS_WEBKIT_WPE_API_1=1"
  WPE_LIBS="$WPE1_LIBS"
else
  echo "WPE WebKit development packages are required." >&2
  echo "  Debian/Ubuntu: libwpewebkit-2.0-dev libwpe-1.0-dev libwpebackend-fdo-1.0-dev" >&2
  echo "  Fedora:        wpewebkit-devel libwpe-devel wpebackend-fdo-devel" >&2
  echo "  Arch:          wpewebkit libwpe wpebackend-fdo" >&2
  exit 1
fi

# wayland-server is needed for wl_shm_buffer_* accessors.
if ! check_pkg "Wayland server" WAYLAND wayland-server; then
  echo "wayland-server is required (for wl_shm_buffer accessors)." >&2
  exit 1
fi

echo ""
echo "=== Probing optional dependencies ==="

# libsoup-3.0 for cookie store conversions (transitively required by
# wpe-webkit-2.0; explicit probe makes the message clearer if missing).
probe_optional "libsoup-3.0 (cookie bridge)" SOUP GS_WEBKIT_HAVE_SOUP libsoup-3.0 || true

# Optional: xkbcommon for richer keyboard translation.  Today we fall
# back to the unicode-keysym path even without xkbcommon, so this is
# advisory.
probe_optional "xkbcommon (keyboard plumbing)" XKB GS_WEBKIT_HAVE_XKB xkbcommon || true

# Optional: EGL (v2 path; SHM works without it).
probe_optional "EGL (future EGL renderer)" EGL GS_WEBKIT_HAVE_EGL egl || true

echo ""
echo "=== Writing config.make ==="

cat > "$SCRIPT_DIR/config.make" <<EOF
# Auto-generated by configure.  Do not edit by hand; re-run
# ./configure to regenerate.

GS_WEBKIT_PREFIX        = $PREFIX
GS_WEBKIT_ENABLE_DEBUG  = $ENABLE_DEBUG

GS_WEBKIT_WPE_CFLAGS    = $WPE_CFLAGS
GS_WEBKIT_WPE_LIBS      = $WPE_LIBS

GS_WEBKIT_WAYLAND_LIBS  = $WAYLAND_LIBS

GS_WEBKIT_SOUP_CFLAGS   = $SOUP_CFLAGS
GS_WEBKIT_SOUP_LIBS     = $SOUP_LIBS

GS_WEBKIT_XKB_CFLAGS    = $XKB_CFLAGS
GS_WEBKIT_XKB_LIBS      = $XKB_LIBS

GS_WEBKIT_EGL_CFLAGS    = $EGL_CFLAGS
GS_WEBKIT_EGL_LIBS      = $EGL_LIBS
EOF

if [ "$ENABLE_DEBUG" = "1" ]; then
  echo "GS_WEBKIT_EXTRA_OBJCFLAGS = -g -O0 -DGS_WEBKIT_DEBUG=1" >> "$SCRIPT_DIR/config.make"
fi

echo ""
echo "Configuration complete.  Run \`make\` to build."
echo "Wrote $SCRIPT_DIR/config.make"
